# 主视觉模型 — 复制此文件为 .env 并填入真实密钥
OPENAI_BASE_URL=https://your-provider.example.com/v1
OPENAI_API_KEY=YOUR_PRIMARY_KEY
OPENAI_VISION_MODEL=your-primary-vision-model

# 备选视觉模型（主模型失败/返回购物建议时自动 fallback）
FALLBACK_BASE_URL=https://your-fallback.example.com/v1
FALLBACK_API_KEY=YOUR_FALLBACK_KEY
FALLBACK_VISION_MODEL=your-fallback-vision-model